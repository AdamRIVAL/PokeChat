<div class="p-2 p-md-5">
  <div class="banner py-5 px-3 px-md-5 text-center rounded">
    <h1 class="my-5 text-white">Vos Pokemons favoris réunis sur Pokéchat !</h1>
  </div>
</div>
<div class="container col-12 p-4 text-center" data-controller="filter-pokemons">
  <div class="mb-3 mb-md-4">
    <h2>Discutez avec un pokémon :</h2>
    <%= render "pokemons/search-bar" %>
  </div>

  <turbo-frame class="row row-cols-2 row-cols-md-4 poke-card-grid" id="pokemon-list" target="_top">
      <% @pokemons.each do |pokemon| %>
        <div class="col p-2">
        <%= render "pokemons/pokemon-card", pokemon: pokemon %>
        </div>
      <% end %>
  </turbo-frame>
</div>

<footer>
  <%= render "shared/footer" %>
</footer>
