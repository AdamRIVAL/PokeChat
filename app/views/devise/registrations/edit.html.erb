<div class="edit-user">

      <div class="retour">
        <div class="salameche">
          <%= image_tag "https://res.cloudinary.com/dohljjbnh/image/upload/v1764276308/gif_temp_rluli5.gif" %>
        </div>

        <%= link_to "retour", :back, class: "btn btn-info m-5" %>
      </div>
  <div class="container-fluid d-flex align-items-center justify-content-center">
    <div class="col-12 col-md-6">


      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.error_notification %>

        <div class="form-inputs" >

          <h2>Personnalisez votre profil</h2>
          <br>
          <%= f.input :email, label: "Identifiant (peut être un mail fictif)", required: true, autofocus: true %>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
          <% end %>

          <%= f.input :password,
                      label: "Nouveau code personnel (ne mettez pas un vrai mot de passe)",
                      placeholder: "Laissez vide si vous ne voulez pas le modifier",
                      required: false,
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :password_confirmation,
                      label: "Confirmez votre nouveau code personnel",
                      required: false,
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :current_password,
                      label: "Code personnel actuel",
                      hint: "Nous avons besoin de votre code personnel actuel pour confirmer vos modifications.",
                      required: true,
                      input_html: { autocomplete: "current-password" } %>

        </div>
        <div class="footer-form">
            <%= f.file_field :photo, class: "form-control btn"%>
          <div class="avatar-wrapped mt-3">

              <% if current_user.photo.attached?%>
                <%= image_tag url_for(current_user.photo), class: "avatar", alt: "dropdown menu" %>
              <%else %>
                <%=  image_tag "https://res.cloudinary.com/dohljjbnh/image/upload/v1764168207/fkffxsqmqkaaytqvycwm.jpg", class: "avatar", alt: "dropdown menu"%>
              <% end %>

          </div>
          <div class="form-actions">
            <div class="pikachu">

              <%= image_tag "https://res.cloudinary.com/dohljjbnh/image/upload/v1764263959/icegif-1479_fmwdup.gif" %>
            </div>
            <%= f.button :submit, "Modifier",class:"btn m-3" %>
          </div>
          <% end %>
      </div>


    <div class="btn-delete"> <%= button_to "Supprimer mon compte", registration_path(resource_name),class: "btn btn-danger mt-5", data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %></div>


    </div>

  </div>

</div>


