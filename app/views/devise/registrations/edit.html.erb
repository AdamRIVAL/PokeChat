<div class="edit-user">

  <div class="container-fluid d-flex align-items-center justify-content-center">
    <div class="col-12 col-md-6 mt-5 p-5">
      <%= link_to "retour", :back, class: "btn btn-info mb-3" %>


      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.error_notification %>

        <div class="form-inputs">
          <h2>Personnalisez votre profil</h2>
          <%= f.input :email,label:"adresse e-mail", required: true, autofocus: true %>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
          <% end %>

          <%= f.input :password,
                      label: "Nouveau mot de passe",
                      placeholder: "Laissez vide si vous ne voulez pas le modifier",
                      required: false,
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :password_confirmation,
                      label: "Confirmez votre nouveau mot de passe",
                      required: false,
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :current_password,
                      label: "Mot de passe actuel",
                      hint: "Nous avons besoin de votre mot de passe actuel pour confirmer vos modifications.",
                      required: true,
                      input_html: { autocomplete: "current-password" } %>

        </div>
        <div class="footer-form">
          <div class="avatar-wrapped mt-3">
            <% if current_user.photo.attached?%>
              <%= image_tag url_for(current_user.photo), class: "avatar", alt: "dropdown menu" %>
            <%else %>
              <%=  image_tag "https://res.cloudinary.com/dohljjbnh/image/upload/v1764168207/fkffxsqmqkaaytqvycwm.jpg", class: "avatar", alt: "dropdown menu"%>
            <% end %>
          </div>
          <%= f.file_field :photo, class: "form-control btn"%>
          <div class="form-actions">
            <%= f.button :submit, "Modifier",class:"btn btn-success  m-3" %>
          </div>
          <% end %>
      </div>


    <div> <%= button_to "Supprimer mon compte", registration_path(resource_name),class: "btn btn-danger mt-5", data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %></div>


    </div>
  </div>

</div>
