
 <div class="container-fluid d-flex align-items-center justify-content-center">
    <div class="row w-100 shadow-lg bg-white rounded-4 overflow-hidden mt-5" style="max-width: 1000px;">

<!-- Formulaire -->
  <div class="col-12 col-md-6 p-5">
    <h2>Connectez-vous</h2>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password,
                    label: "Mot de passe",
                    required: false,
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Se connecter", class: "btn btn-primary me-3" %>
    <%= render "devise/shared/links" %>
      </div>
    <% end %>

  </div>

<!-- Illustration -->
  <div class="col-md-6 d-none d-md-flex align-items-center justify-content-center bg-primary bg-gradient text-white p-5">
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/9/98/International_Pok%C3%A9mon_logo.svg/1200px-International_Pok%C3%A9mon_logo.svg.png" class="img-fluid" alt="Illustration">
  </div>


</div>
</div>
