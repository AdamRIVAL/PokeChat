<div class="row">
  <turbo-frame class="col-sm-8 my-3" target="pokemon-list" id="form">
    <%= form_with url: user_signed_in? ? pokemons_path : root_path, method: :get, class: "d-flex", data: { filter_pokemons_target:"form" } do %>
      <%= label_tag :query, "Chercher un pokemon", class: "visually-hidden" %>
      <%= text_field_tag :query,
            params[:query],
            class: "form-control",
            placeholder: "Chercher un pokemon",
            data: { action:"keyup->filter-pokemons#filter" }
        %>
      <%= submit_tag "Rechecher", name: "", class: "btn btn-primary" %>
    <% end %>
  </turbo-frame>
</div>
