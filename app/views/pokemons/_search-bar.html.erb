<div class="d-flex justify-content-center">
  <turbo-frame class="col-sm-8 my-3 flex-grow-1 flex-lg-grow-0" target="pokemon-list" id="form">
    <%= form_with url: user_signed_in? ? pokemons_path : root_path, method: :get, class: "d-flex gap-2 flex-grow-1", data: { filter_pokemons_target:"form" } do %>
      <%= label_tag :query, "Chercher un pokemon", class: "visually-hidden" %>
      <%= text_field_tag :query,
            params[:query],
            class: "form-control bg-white p-3 flex-grow-1",
            placeholder: "Chercher un pokemon",
            data: { action:"keyup->filter-pokemons#filter" }
        %>
      <%= submit_tag "Rechercher", name: "", class: "btn btn-primary" %>
    <% end %>
  </turbo-frame>
</div>
