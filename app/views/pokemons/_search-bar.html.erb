<div class="row">
  <div class="col-sm-8 my-3">
    <%= form_with url: user_signed_in? ? pokemons_path : root_path, method: :get, class: "d-flex" do %>
      <%= label_tag :query, "Chercher un pokemon", class: "visually-hidden" %>
      <%= text_field_tag :query,
            params[:query],
            class: "form-control",
            placeholder: "Chercher un pokemon"
        %>
      <%= submit_tag "Rechecher", name: "", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
