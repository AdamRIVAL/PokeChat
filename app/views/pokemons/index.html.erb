<div class="d-flex">

    <%# Section CHATS %>
    <div class="<%= @chats.any? ? "col-3" : "d-none" %>">
      <div class="chat-history">
        <%= render "pokemons/chat-history", chats: @chats %>
      </div>
    </div>

    <%# Section MAIN (Cards + search bar) %>
    <div class="container p-4 <%= @chats.any? ? "col-9" : "col-12" %>" data-controller="filter-pokemons">
      <div class="main-head-search my-4 text-center">
        <h2>Avec quel Pokemon souhaitez-vous discuter ?</h2>
        <%= render "pokemons/search-bar" %>
        <%= render "pokemons/tabs" %>
      </div>

      <turbo-frame class="row row-cols-1 poke-card-grid <%= @chats.any? ? "row-cols-md-3" : "row-cols-md-4" %>" id="pokemon-list" target="_top">

        <%= render "pokemons/tab-content" %>

      </turbo-frame>
    </div>
</div>
