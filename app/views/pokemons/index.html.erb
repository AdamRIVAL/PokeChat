<div class="container">

  <div class="row">
  <%# Section CHATS %>
    <div class="col">
      <%= render "pokemons/chat-history" %>
    </div>

    <%# Section PRINCIPALE (Cards + search bar) %>
    <div class="col-9">
      <h2>Avec quel Pokemon souhaitez-vous discuter ?</h2>

      <%= render "pokemons/search-bar" %>

        <div class="row row-cols-3">
          <% @pokemons.each do |pokemon| %>
          <div class="col p-2">
          <%= render "pokemons/pokemon-card", pokemon: pokemon %>
          </div>
          <% end %>
        </div>
    </div>
  </div>

</div>
