<div class="container">

  <div class="row">
  <%# Section CHATS %>
    <div class="col">

    </div>

    <%# Section MAIN (Cards + search bar) %>
    <div class="col-9">
      <h2>Avec quel Pokemon souhaitez-vous discuter ?</h2>
        <div class="row">

          <%# A remplacer par les CARDS de Quentin %>
          <% @pokemons.each do |pokemon| %>
          <div class="col-3 d-flex flex-wrap">
            <%= link_to pokemon_path(pokemon) do %>
            <div class="card">
              <%= image_tag pokemon.sprite, class: "card-img-top ", alt: "pokemon picture" %>
              <div class="card-body">
                <h5 class="card-title"><%= pokemon.name %></h5>
              </div>
            </div>
            <% end %>
          </div>
          <% end %>
        </div>
    </div>
  </div>
</div>
