<div class="d-flex">
  <%# Section CHATS %>

  <%# ici on affiche la sidebar si il y a des chats :  %>
  <% if @chats.count > 0 %>
    <div class="col-3">
      <div class="chat-history">
        <%= render "pokemons/chat-history", chats: @chats %>
      </div>
    </div>

    <%# Section MAIN (Cards + search bar) %>
    <div class="container col-9 p-4">
      <div class="main-head-search my-4 text-center">
        <h2>Avec quel Pokemon souhaitez-vous discuter ?</h2>
        <%= render "pokemons/search-bar" %>
      </div>
      <div class="row row-cols-1 row-cols-md-3 poke-card-grid" id="pokemon-list">

    <% else %>

    <div class="container col-12 p-4">
      <div class="main-head-search my-4 text-center">
        <h2>Avec quel Pokemon souhaitez-vous discuter ?</h2>
        <%= render "pokemons/search-bar" %>
      </div>
      <div class="row row-cols-1 row-cols-md-4 poke-card-grid" id="pokemon-list">

  <%# fin de la condition  %>
  <% end %>
        <% @pokemons.each do |pokemon| %>
          <div class="col p-2">
          <%= render "pokemons/pokemon-card", pokemon: pokemon %>
          </div>
        <% end %>
      </div>
    </div>
</div>
