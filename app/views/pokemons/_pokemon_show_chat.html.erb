<div>
  <div class="message-chat">
    <div class="chat-head d-flex justify-content-between mb-4">
      <h3>Discuter avec <%= @pokemon.name %></h3>
        <%= link_to chat_path(@chat), class: "btn btn-outline-secondary", data: {turbo_method: :delete} do %>
          <i class="fa-solid fa-arrow-rotate-left"></i>
          Redémarrer un chat
        <% end %>
    </div>
    <div class="messages-container d-flex flex-column gap-3" id="messages">
      <% @chat.messages.each do |message| %>
           <%= render "messages/message", message: message %>
      <% end %>
    </div>
  </div>

<turbo-frame id="message_form">
  <div class= "form-chat col-9 p-2 p-md-4">
    <%= simple_form_for [@chat, @message], html: {class: 'd-flex gap-3' } do |f| %>
      <%= f.input :content, required: true, label: false, placeholder: "Discuter avec #{@pokemon.name}", input_html: {class: 'flex-grow-1' }, class: "bg-white" %>
      <%= f.button :submit, 'Envoyer', { data: {action: "click->btn-submit#animation"}, class: 'btn btn-primary', id: "btn-submit"} %>
    <% end %>
  </div>
</turbo-frame>
</div>
