<div>
  <div class="message-chat">
    <h3>Messages with <%= @pokemon.name %></h3>
    <% @chat.messages.each do |message| %>
    <% if message.role == "user" %>
        <div class="d-flex justify-content-end mb-2">
          <div class="bg-white px-4 py-2 rounded-pill">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% elsif message.role == "assistant" %>
        <div class="d-flex justify-content-start mb-5">
          <div class="px-3 pb-0 pt-3 pokemon-response">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class= "form-chat col-9">
    <%= simple_form_for [@chat, @message], html: {class: 'd-flex gap-2' } do |f| %>
      <%= f.input :content, required: true, label: false, placeholder: "Have a chit chat with #{@pokemon.name}", input_html: {class: 'flex-grow-1' }%>
      <%= f.button :submit, 'Envoyez', class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>
