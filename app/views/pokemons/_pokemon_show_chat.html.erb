<div>
<div class="message-chat">
  <h3>Pokedex translation interface</h3>
  <% @chat.messages.each do |message| %>
  <% if message.role == "user" %>
      <div class="d-flex justify-content-end mb-2">
        <div class="bg-white px-3 pb-0 pt-3 rounded-pill">
          <%= raw(render_markdown(message.content)) %>
        </div>
      </div>
    <% elsif message.role == "assistant" %>
      <div class="d-flex justify-content-start mb-5">
        <div class="px-3 pb-0 pt-3">
          <%= raw(render_markdown(message.content)) %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<div class= "form-chat">
  <%= simple_form_for [@chat, @message] do |f| %>
    <%= f.input :content, required: true, label: " ", placeholder: "Have a chit chat with #{@pokemon.name}"%>
    <%= f.button :submit, 'Envoyez', class: 'btn btn-primary', id: "btn-summit" %>
  <% end %>
</div>
</div>
