<div>
  <div class="message-chat">
    <div class="chat-head d-flex justify-content-between mb-4">
      <h3>Discuter avec <%= @pokemon.name %></h3>
        <%= link_to chat_path(@chat), class: "btn btn-outline-secondary", data: {turbo_method: :delete} do %>
          <i class="fa-solid fa-arrow-rotate-left"></i>
          Redémarrer un chat
        <% end %>
    </div>
    <div class="messages-container d-flex flex-column gap-3">
      <% @chat.messages.each do |message| %>
        <% if message.role == "user" %>
          <div class="d-flex justify-content-end">
            <div class="bg-white px-4 py-2 rounded-pill">
              <%= raw(render_markdown(message.content)) %>
            </div>
          </div>
        <% elsif message.role == "assistant" %>
          <div class="d-flex justify-content-start">
            <div class="px-4 py-2 pokemon-response">
              <%= raw(render_markdown(message.intro)) %>
              <!-- <p><%= @pokemon.name %> vous dit :</p> -->
              <%= raw(render_markdown(message.content)) %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class= "form-chat col-9 p-4">
    <%= simple_form_for [@chat, @message], html: {class: 'd-flex gap-3' } do |f| %>
      <%= f.input :content, required: true, label: false, placeholder: "Discutez avec #{@pokemon.name}", input_html: {class: 'flex-grow-1' }, class: "bg-white" %>
      <%= f.button :submit, 'Envoyez', { data: {action: "click->btn-submit#animation"}, class: 'btn btn-primary', id: "btn-submit"} %>
    <% end %>
  </div>
</div>
