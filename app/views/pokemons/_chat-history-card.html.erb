  <div class="btn btn-light d-flex align-items-center">
    <%= link_to pokemon_path(pokemon), class: "chat-link flex-grow-1" do %>
      <div class="d-flex flex-row gap-2 align-items-center chat-pokemon">
        <%= image_tag(chat.pokemon.sprite) %>
        <p><%= chat.pokemon.name.capitalize %></p>
      </div>
      <p class="text-start text-secondary">Untitled</p>
    <% end %>

    <%= link_to chat_path(chat), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} do %>
      <div class="btn btn-close"></div>
    <% end %>
  </div>
