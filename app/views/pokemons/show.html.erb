<div class="page_show d-flex" data-controller="btn-submit">

  <div class="pokemon-aura" style="background-color: <%= @pokemon.color %>"></div>

  <%# sidebar left %>
  <div class="col">
    <div class="pokemon-show-sidebar d-flex flex-column p-2 p-md-4 gap-3">
      <%= render "pokemons/pokemon_show_info" %>
    </div>
  </div>

  <%# main container messages + form %>
  <div class="container col-9 p-2 p-md-4">
    <%= render "pokemons/pokemon_show_chat" %>
  </div>

</div>
