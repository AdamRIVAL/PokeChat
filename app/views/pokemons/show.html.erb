<%# Julien, controller messages def create %>
<div>
  <h1>Messages</h1>

  <% @chat.messages.each do |message| %>
   <p><%= message.content %></p>
  <% end %>


  <%= simple_form_for [@chat, @message] do |f| %>
    <%= f.input :content, required: true, label: "Posez votre question:", placeholder: "..."%>
    <%= f.button :submit, 'Envoyez', class: 'btn btn-primary' %>
  <% end %>
</div>
<%# /Julien, controller messages def create%>

