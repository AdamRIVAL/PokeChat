<div class="pokemon_show_info">
  <div class="pokepikture">
    <%= image_tag @pokemon.sprite, alt: "PikaPika", width: 200 %>
  </div>

    <div class="card-body p-3">
        <h5 class="card-title"><%= @pokemon.name %></h5>
        <p class="card-text"><%= @pokemon.description %></p>
    </div>
    <ul class="list-group list-group-flush"></ul>
    <div class="d-flex flex-row p-3 gap-2 justify-content-center">
      <% @pokemon.types.each do |type| %>
      <div class="badge rounded-pill text-bg-light bg-body-secondary fs-6">
        <%= image_tag type %>
      </div>
        <% end %>
    </div>

</div>

<div class= "link-home">

  <%= link_to "Go back to the catch them all home", pokemons_path, class:"btn btn-warning rounded-3 mt-5" %>

</div>
