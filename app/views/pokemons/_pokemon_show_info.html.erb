<%= link_to pokemons_path, class:"btn btn-light d-flex align-items-center gap-2", style: "border-color: #{@pokemon.color} !important; color: black !important" do %>
  <i class="fa-solid fa-arrow-left"></i>
   Retour
<% end %>

<div class="pokemon_show_info rounded card bg-white gap-2 d-flex flex-column">
  <div class="card-body">
    <div class="pokepikture">
      <div class="poke-card-img">
        <%= image_tag(@pokemon.sprite, class: "img-main", alt: @pokemon.name) %>
        <%= image_tag(@pokemon.sprite, class: "img-blur") %>
      </div>
    </div>

      <div class="d-flex flex-column p-3 gap-3 text-center">
          <h5 class="card-title"><%= @pokemon.name %></h5>
          <div class="d-flex flex-row gap-2 justify-content-center poke-types">
            <% @pokemon.types.each do |type| %>
              <%= image_tag type %>
            <% end %>
          </div>
          <p class="card-text"><%= @pokemon.description %></p>
      </div>

  </div>
</div>
